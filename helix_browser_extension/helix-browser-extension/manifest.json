{
  "manifest_version": 3,
  "name": "Helix Coordination Analyzer",
  "version": "1.0.0",
  "description": "One-click coordination analysis for any webpage. Powered by Helix Collective AI.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://helixspiral.work/*",
    "https://*.helixspiral.work/*",
    "https://helix-ai.dev/*",
    "https://*.helix-ai.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://helixspiral.work/*",
        "*://*.helixspiral.work/*",
        "*://helix-ai.dev/*",
        "*://*.helix-ai.dev/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
